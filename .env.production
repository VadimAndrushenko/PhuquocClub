# ============================================
# 🌐 SERVER URL
# ============================================
NEXT_PUBLIC_SERVER_URL=https://phuquoc.club

# ============================================
# 🔐 PAYLOAD CMS
# ============================================
# Сгенерируй новый секрет командой: openssl rand -hex 32
PAYLOAD_SECRET=your_production_secret_key_minimum_32_characters

# ============================================
# 🗄️ DATABASE (PostgreSQL для продакшена)
# ============================================
# Варианты:
# - Vercel Postgres: через интеграцию в панели Vercel
# - Neon: https://neon.tech (бесплатный тариф)
# - Supabase: https://supabase.com (бесплатный тариф)
DATABASE_URL=postgresql://user:password@host:5432/mydb

# ============================================
# ⚠️ ВАЖНО: SQLite НЕ подходит для Vercel!
# ============================================
# Файловая система на Vercel непостоянная,
# данные SQLite будут удаляться после каждого деплоя.
# Обязательно используй PostgreSQL для продакшена.