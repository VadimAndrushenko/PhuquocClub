# ============================================
# 🌐 SERVER URL
# ============================================
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ============================================
# 🔐 PAYLOAD CMS
# ============================================
PAYLOAD_SECRET=your_secret_key_minimum_32_characters_here

# ============================================
# 🗄️ DATABASE (PostgreSQL для продакшена)
# ============================================
# Для разработки (SQLite):
# DATABASE_URL=file:./dataPayload.db

# Для продакшена (PostgreSQL - Neon/Vercel Postgres/Supabase):
DATABASE_URL=postgresql://user:password@host:5432/mydb

# ============================================
# 📦 VERCEL (автоматически добавляются платформой)
# ============================================
# NEXT_PUBLIC_VERCEL_URL - автоматически добавляется Vercel
# VERCEL_ENV - автоматически добавляется Vercel (development/preview/production)
